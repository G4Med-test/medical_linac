# EURADOS "Linac Action" validation: GE Saturn 43, 12 MV photon mode,
# 10x10 cm2 field at SSD 90 cm (the DetectorConstruction defaults), dose in water.
# Settings follow geant-config-generator/tests/geant4/medical_linac/template.conf.

#### verbosities
/control/verbose 1
/material/verbose 0
/run/verbose 0
/process/em/verbose 0

/run/numberOfThreads 8

/physics/addPhysics standard_opt4

/random/setSeeds 250 353

/run/initialize

# Primary electron beam (same values as the PrimaryGeneratorMessenger defaults).
# The generator is built by ActionInitialization: set it after /run/initialize.
/PrimaryGenerator/gunMeanEnergy 12 MeV
/PrimaryGenerator/gunStdEnergy 0.127 MeV
/PrimaryGenerator/gunRadius 1 mm

# 5 mm voxels aligned with the experimental points: depth bins centred at
# 5, 10, ..., 255 mm from the water surface (z = 0), lateral bins at 0, +-5, ... mm
/score/create/boxMesh boxMesh_1
/score/mesh/translate/xyz 0 0 130 mm
/score/mesh/boxSize 127.5 127.5 127.5 mm
/score/mesh/nBin 51 51 51
/score/quantity/doseDeposit dDep
/score/close
/score/list

/run/printProgress 10000000
/run/beamOn 1000000000

/score/dumpQuantityToFile boxMesh_1 dDep dDep.txt
