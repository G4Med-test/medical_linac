#
# Macro file for "medical_linac" (short smoke test, run on every push)
#
/control/verbose 0
/run/verbose 0
/process/em/verbose 0

/run/numberOfThreads 1

/physics/addPhysics standard_opt4

/run/initialize

/PrimaryGenerator/gunMeanEnergy 12 MeV

/score/create/boxMesh boxMesh_1
/score/mesh/translate/xyz 0 0 130 mm
/score/mesh/boxSize 127.5 127.5 127.5 mm
/score/mesh/nBin 51 51 51
/score/quantity/doseDeposit dDep
/score/close

/run/printProgress 1000
/run/beamOn 1000

/score/dumpQuantityToFile boxMesh_1 dDep dDep.txt
